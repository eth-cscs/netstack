#!/usr/bin/env -S uv run --no-refresh --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#   "rich",
#   "tabulate",
# ]
# ///

# vim: set syntax=python:

"""Report the user-land network stack of a loaded uenv.

Run this *inside* a uenv view, e.g.:

    uenv run --view=default prgenv-gnu/25.11:v1 -- ./bin/user-stack

It inspects the active view (the libraries actually on `PATH` /
`LD_LIBRARY_PATH`) and reports the network-stack components — MPI, GTL,
libfabric + providers, libcxi, the Slingshot headers the fabric libraries were
built against, NCCL, aws-ofi-nccl, the CUDA runtime, XPMEM, PMI, PALS —
together with the version of each and, crucially, whether it is *provided by
the uenv* or *provided by the host*.

Provenance is never guessed from a library's name: for every dependency we
resolve the path the dynamic loader actually uses (via `libtree`, falling back
to `ldd`) and test whether it falls under the uenv mount point.  A component
such as `libcxi` may be host-provided in one uenv and uenv-provided in another;
only the resolved path tells the truth.  `libtree` additionally reports *how*
each library was found (rpath, runpath, LD_LIBRARY_PATH, default search path),
which is captured in the "Found via" column.

What each resolved path *is* comes from a package database: the uenv's Spack
database for a library under the mount, and the host RPM database for one that
is not.  A host library therefore reports the same version and the same SHS
release that `system-stack` reports for it, which is what allows the two halves
of a stack to be compared.  Components are emitted in the shared record defined
in `netstack.py`.
"""

import argparse
import glob
import json
import os
import re
import shutil
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import netstack  # noqa: E402
import rpmdb  # noqa: E402
from spackdb import SpackDB  # noqa: E402

from rich import box
from rich.console import Console
from rich.style import Style
from rich.table import Table
from tabulate import tabulate


# The columns of the component table that this side of the stack can fill.
# There is no install prefix column: a resolved path says more.
COLUMNS = ('name', 'version', 'shs', 'origin', 'via', 'hash')


# ---------------------------------------------------------------------------
# uenv discovery
# ---------------------------------------------------------------------------

def _uenv_mounts():
    """Return the list of uenv mount points (e.g. ['/user-environment']).

    Parsed from UENV_MOUNT_LIST, whose format is a comma-separated list of
    `<squashfs-path>:<mount-point>` pairs.
    """
    raw = os.environ.get('UENV_MOUNT_LIST') or os.environ.get('SQUASHFS_MOUNT_LIST') or ''
    mounts = []
    for entry in raw.split(','):
        entry = entry.strip()
        if not entry or ':' not in entry:
            continue
        # squashfs path and mount point are separated by the last ':'
        mount = entry.rsplit(':', 1)[1]
        if mount:
            mounts.append(mount)
    return mounts


def _uenv_identity():
    """Return a dict describing the loaded uenv, or None if none is loaded."""
    view = os.environ.get('UENV_VIEW')
    if not view:
        return None

    ident = {
        'label':    os.environ.get('UENV_LABEL'),
        'name':     None,
        'mount':    None,
        'view':     None,
        'arch':     None,
        'system':   os.environ.get('CLUSTER_NAME'),
    }

    # UENV_VIEW = <mount>:<name>:<view>
    parts = view.split(':')
    if len(parts) == 3:
        ident['mount'], ident['name'], ident['view'] = parts

    telem = os.environ.get('UENV_TELEMETRY')
    if telem:
        try:
            records = json.loads(telem)
            if records:
                rec = records[0]
                ident['label'] = ident['label'] or rec.get('label')
                ident['name'] = ident['name'] or rec.get('name')
                ident['mount'] = ident['mount'] or rec.get('mount')
                views = rec.get('views')
                if views and not ident['view']:
                    ident['view'] = views[0]
        except (ValueError, KeyError):
            pass

    # Spack target arch = the linux-<...> directory in the store.
    if ident['mount']:
        for d in glob.glob(os.path.join(ident['mount'], 'linux-*')):
            ident['arch'] = os.path.basename(d)
            break

    return ident


def _view_lib_dirs(ident):
    """Return the library directories of the active view (under the mount)."""
    dirs = []
    if ident and ident['mount'] and ident['view']:
        base = os.path.join(ident['mount'], 'env', ident['view'])
        for sub in ('lib', 'lib64'):
            d = os.path.join(base, sub)
            if os.path.isdir(d):
                dirs.append(d)
    # Fall back to any LD_LIBRARY_PATH entry under a mount.
    mounts = _uenv_mounts()
    for d in os.environ.get('LD_LIBRARY_PATH', '').split(':'):
        if d and os.path.isdir(d) and any(_under(d, m) for m in mounts) and d not in dirs:
            dirs.append(d)
    return dirs


# ---------------------------------------------------------------------------
# path / provenance helpers
# ---------------------------------------------------------------------------

def _under(path, root):
    """True if `path` is `root` or lives beneath it."""
    if not path or not root:
        return False
    path = os.path.realpath(path)
    root = os.path.realpath(root)
    return path == root or path.startswith(root + os.sep)


def _origin(path, mounts):
    """Classify a resolved path as 'uenv' or 'host'."""
    if path and any(_under(path, m) for m in mounts):
        return 'uenv'
    return 'host'


def _deptree(path):
    """Return {soname: (resolved_path, how)} for a shared object.

    `how` records how the dynamic loader located the library: 'rpath',
    'runpath', 'LD_LIBRARY_PATH', 'default path', etc.

    Uses `libtree -p`, which resolves ELF dependencies *statically* (without
    executing the object, unlike ldd) and, importantly, annotates each entry
    with the search mechanism that found it.  Falls back to `ldd` if libtree
    is not on PATH.
    """
    if shutil.which('libtree'):
        tree = _deptree_libtree(path)
        if tree:
            return tree
    return _deptree_ldd(path)


def _deptree_libtree(path):
    """Parse `libtree -p <path>` into {soname: (resolved_path, how)}."""
    result = {}
    try:
        out = subprocess.run(['libtree', '-p', path], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return result
    if out.returncode != 0:
        return result
    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        # Each line is tree-drawing chars, then an absolute path, then an
        # optional "[how]" annotation.  The root line has no annotation.
        idx = line.find('/')
        if idx < 0:
            continue
        rest = line[idx:]
        how = None
        m = re.search(r'\[([^\]]+)\]\s*$', rest)
        if m:
            how = m.group(1)
            rest = rest[:m.start()]
        target = rest.strip()
        if not target.startswith('/'):
            continue
        soname = os.path.basename(target)
        # Keep the shallowest occurrence (closest to the queried library).
        result.setdefault(soname, (target, how))
    return result


def _deptree_ldd(path):
    """Fallback: parse `ldd <path>` into {soname: (resolved_path, None)}."""
    result = {}
    try:
        out = subprocess.run(['ldd', path], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return result
    if out.returncode != 0:
        return result
    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        m = re.match(r'\s*(\S+)\s+=>\s+(/\S+)', line)
        if m:
            result.setdefault(m.group(1), (m.group(2), None))
    return result


# ---------------------------------------------------------------------------
# version extraction
# ---------------------------------------------------------------------------

_SPACK_HASH = re.compile(r'-[a-z0-9]{32}(?:/|$)')


def _version_from_store(name, path):
    """Extract a version from a spack store dir `<name>-<version>-<hash>`."""
    if not path:
        return None
    m = re.search(re.escape(name) + r'-(.+?)-[a-z0-9]{32}(?:/|$)', path)
    if m:
        return m.group(1)
    return None


def _version_from_path(path):
    """Extract a version-looking path component (e.g. .../libfabric/1.22.0/...)."""
    if not path:
        return None
    for part in path.split(os.sep):
        if re.fullmatch(r'\d+\.\d+(?:\.\d+)*', part):
            return part
    return None


def _version_from_soname(path):
    """Extract a version from a resolved soname, e.g. libnccl.so.2.28.3 -> 2.28.3."""
    if not path:
        return None
    real = os.path.realpath(path)
    m = re.search(r'\.so\.(\d+(?:\.\d+)+)$', real)
    if m:
        return m.group(1)
    return None


def _version(name, path, prefer='store'):
    """Best-effort (version, source) for a component at `path`.

    `prefer` selects the first strategy to try; the rest are used as
    fallbacks.  Strategies: 'store' (spack dir), 'path' (version path
    segment), 'soname' (resolved .so.X.Y.Z).  The winning strategy is returned
    alongside the version as its `version_source`.
    """
    # Resolve symlinks first: store-dir and version-path segments live on the
    # real target, not on the view symlink that points at it.
    real = os.path.realpath(path) if path else None
    strategies = {
        'store':  lambda: _version_from_store(name, real),
        'path':   lambda: _version_from_path(real),
        'soname': lambda: _version_from_soname(real),
    }
    order = [prefer] + [s for s in ('store', 'path', 'soname') if s != prefer]
    for s in order:
        v = strategies[s]()
        if not v:
            continue
        # A git version names a commit or a tag, not a version of the package:
        # the release it declares is reported as `shs` instead.
        if netstack.parse_git_version(v)[0]:
            continue
        # An all-zero soname (e.g. libxpmem.so.0.0.0) carries no real version.
        if re.fullmatch(r'0(?:\.0)*', v):
            continue
        return v, s
    return None, None


# ---------------------------------------------------------------------------
# component detection
# ---------------------------------------------------------------------------

def _find_lib(sonames, lib_dirs):
    """Return the path of the first matching library in the view lib dirs."""
    for d in lib_dirs:
        for pattern in sonames:
            hits = sorted(glob.glob(os.path.join(d, pattern)))
            # Prefer a real file / versioned soname over a bare symlink stub.
            for h in hits:
                return h
    return None


def _mpichversion(field):
    """Return a line from `mpichversion` output matching `field`, or None."""
    try:
        out = subprocess.run(['mpichversion'], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return None
    if out.returncode != 0:
        return None
    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        if line.startswith(field):
            return line.split(':', 1)[1].strip()
    return None


def _mpi_flavor(mpi_lib):
    """Identify the MPI implementation: 'openmpi', 'cray-mpich', 'mpich', None.

    Primary signal is the Spack store directory the MPI library resolves to
    (`openmpi-*`, `cray-mpich-*`, `mpich-*`) — robust because view libraries are
    symlinks into the store. Falls back to the presence of `ompi_info` /
    `mpichversion` for non-store installs.
    """
    if mpi_lib:
        real = os.path.realpath(mpi_lib)
        if re.search(r'/openmpi-', real):
            return 'openmpi'
        if re.search(r'/cray-mpich-', real):
            return 'cray-mpich'
        if re.search(r'/mpich-', real):
            return 'mpich'
        # Open MPI's core library is libmpi.so.NN with no MPICH-style names.
        if re.search(r'/libmpi\.so', real) and shutil.which('ompi_info'):
            return 'openmpi'
    if shutil.which('ompi_info'):
        return 'openmpi'
    if _mpichversion('MPICH Version'):
        # Cray MPICH stamps a Cray-specific "Custom Information" line.
        return 'cray-mpich' if _mpichversion('MPICH Custom Information') else 'mpich'
    return None


def _ompi_version():
    """Open MPI version from `ompi_info --version`, or None."""
    try:
        out = subprocess.run(['ompi_info', '--version'], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return None
    if out.returncode != 0:
        return None
    m = re.search(r'Open MPI\s+v?(\d+\.\d+(?:\.\d+)*)',
                  out.stdout.decode('utf-8', 'replace'))
    return m.group(1) if m else None


def _fi_providers():
    """Return list of libfabric providers via `fi_info -l`, or []."""
    try:
        out = subprocess.run(['fi_info', '-l'], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return []
    if out.returncode != 0:
        return []
    providers = []
    for line in out.stdout.decode('utf-8', 'replace').splitlines():
        m = re.match(r'^(\S+):\s*$', line)
        if m:
            providers.append(m.group(1))
    return providers


def collect_components(ident, db=None):
    """Return a list of netstack component records, as defined in `netstack`.

    Components that are not present in the stack are omitted entirely.  A
    component under the uenv mount gets a `uenv` origin, carrying the dag-hash
    of the Spack package that owns it — the authoritative identity that ties a
    loaded object back to the store.  Everything else is on the host, and is
    resolved against the RPM database in one call at the end.
    """
    mounts = _uenv_mounts()
    lib_dirs = _view_lib_dirs(ident)

    # Anchor libraries whose dependency tree reveals the runtime netstack.
    anchor_globs = [
        ['libmpi_gnu_*.so.*', 'libmpi.so.*', 'libmpi.so', 'libmpich.so*'],
        ['libnccl.so.*'],
        ['libnccl-net-ofi.so', 'libnccl-net.so'],
    ]
    anchors = [p for g in anchor_globs if (p := _find_lib(g, lib_dirs))]

    # Merge the dependency trees of all anchors -> {soname: (path, how)},
    # including the anchors themselves (found directly in the view).
    resolved = {}
    for a in anchors:
        resolved.setdefault(os.path.basename(a), (a, 'view'))
        for soname, (path, how) in _deptree(a).items():
            resolved.setdefault(soname, (path, how))

    def lookup(soname_res):
        """Return (path, how) for the first soname matching one of the regexes."""
        for soname, (path, how) in resolved.items():
            for pat in soname_res:
                if re.match(pat, soname):
                    return path, how
        return None, None

    rows = []
    host_pending = []   # (row, prefer, version) — resolved by one RPM query

    def add(name, path, how=None, prefer='store', version=None):
        """Record the component found at `path`.

        `version` overrides the version strategies with an explicit
        (value, source) pair, for the components that can be asked directly.
        A component that is not present in the stack is simply omitted.
        """
        if path is None and version is None:
            return
        real = os.path.realpath(path) if path else None
        if real and _origin(real, mounts) == 'host':
            # Which package put it there is answered for the whole stack at
            # once, once every component has been found.
            row = netstack.component(name, path=real, via=how)
            host_pending.append((row, prefer, version))
            rows.append(row)
            return
        # Tie an in-uenv library back to its Spack package (authoritative id).
        pkg = db.owner_by_hash_in_path(real) if (db and real) else None
        v, source = version if version is not None else _version(name, real, prefer)
        rows.append(netstack.component(
            name,
            version=v,
            version_source=source,
            # For a Slingshot package the Spack version is the SHS release
            # rather than a version of the package itself.
            shs=netstack.shs_from_spack_version(name, pkg.version) if pkg else None,
            origin=netstack.origin_uenv(mount=ident.get('mount'),
                                        hash=pkg.hash if pkg else None,
                                        spack_version=pkg.version if pkg else None)
                   if real else None,
            prefix=pkg.prefix if pkg else None,
            path=real,
            via=how))

    # --- MPI ---------------------------------------------------------------
    mpi_lib = _find_lib(['libmpi_gnu_*.so.*', 'libmpi.so.*', 'libmpi.so',
                         'libmpich.so*'], lib_dirs)
    flavor = _mpi_flavor(mpi_lib)
    if flavor == 'openmpi':
        ver = _ompi_version()
        add('openmpi', mpi_lib, how='view',
            version=(ver, 'runtime') if ver else _version('openmpi', mpi_lib, 'store'))
    elif flavor in ('cray-mpich', 'mpich'):
        # The store directory names the Cray release (8.1.32); `mpichversion`
        # answers for an MPICH that was not installed by Spack.
        ver, source = _version(flavor, mpi_lib, 'store')
        if not ver:
            ver, source = _mpichversion('MPICH Version'), 'runtime'
        add(flavor, mpi_lib, how='view', version=(ver, source))
    elif mpi_lib:
        add('mpi', mpi_lib, how='view')
    else:
        add('cray-mpich', None)

    # --- GTL (GPU transport layer) ----------------------------------------
    # Cray MPICH's GPU-aware path. Open MPI is CUDA-aware without a GTL, so the
    # row is only meaningful (present or absent) for a Cray MPICH stack.
    if flavor in ('cray-mpich', None):
        gtl, how = lookup([r'libmpi_gtl_cuda'])
        if gtl is None:
            gtl, how = _find_lib(['libmpi_gtl_cuda.so'], lib_dirs), 'view'
        add('cray-gtl', gtl, how=how)

    # --- libfabric ---------------------------------------------------------
    # store dir gives the release (2.3.1); the soname is the ABI version.
    fab, how = lookup([r'libfabric\.so'])
    add('libfabric', fab, how=how, prefer='store')

    # --- libcxi ------------------------------------------------------------
    cxi, how = lookup([r'libcxi\.so'])
    add('libcxi', cxi, how=how, prefer='soname')

    # --- Slingshot headers -------------------------------------------------
    # Header-only build dependencies of the fabric libraries above: nothing is
    # loaded at run time, so they must come from the Spack database.
    rows.extend(_slingshot_header_rows(db, rows, ident.get('mount')))

    # --- NCCL --------------------------------------------------------------
    nccl, how = lookup([r'libnccl\.so\.\d'])
    if nccl is None:
        nccl, how = _find_lib(['libnccl.so.*'], lib_dirs), 'view'
    add('nccl', nccl, how=how, prefer='soname')

    # --- aws-ofi-nccl ------------------------------------------------------
    aws = _find_lib(['libnccl-net-ofi.so', 'libnccl-net.so'], lib_dirs)
    add('aws-ofi-nccl', aws, how='view', prefer='store')

    # --- CUDA runtime ------------------------------------------------------
    cudart, how = lookup([r'libcudart\.so'])
    add('cuda', cudart, how=how, prefer='store')

    # --- CUDA driver -------------------------------------------------------
    cudadrv, how = lookup([r'libcuda\.so'])
    drv_ver = _driver_version() if cudadrv else None
    add('cuda-driver', cudadrv, how=how, prefer='soname',
        version=(drv_ver, 'runtime') if drv_ver else None)

    # --- XPMEM -------------------------------------------------------------
    xpmem, how = lookup([r'libxpmem\.so'])
    add('xpmem', xpmem, how=how, prefer='soname')

    # --- process management ------------------------------------------------
    # PMIx (Open MPI and anything using it); Cray PMI + PALS (Cray MPICH).
    pmix, how = lookup([r'libpmix\.so'])
    if pmix is None:
        pmix, how = _find_lib(['libpmix.so.*'], lib_dirs), 'view'
    if pmix is not None:
        add('pmix', pmix, how=how, prefer='soname')

    pmi, how = lookup([r'libpmi\.so', r'libpmi2\.so'])
    if pmi is not None or flavor in ('cray-mpich', 'mpich'):
        add('cray-pmi', pmi, how=how, prefer='store')

    # PALS is the Cray launcher; only report it for a Cray MPICH stack.
    if flavor in ('cray-mpich', None):
        pals = _find_lib(['libpals.so*', 'libpmi2_pals.so*'], lib_dirs)
        add('cray-pals', pals, how='view', prefer='store')

    _resolve_host_origins(host_pending)
    return rows


def _resolve_host_origins(pending):
    """Fill in the origin and version of every host-provided component.

    One `rpm -qf` call covers the whole stack.  A host file that an RPM owns is
    reported the way `system-stack` reports it, with the same package version
    and the same SHS release, which is what lets the two halves of a stack be
    compared; the soname stays visible in the resolved path.  A file that no
    package owns — `/opt/cray/libfabric/1.22.0` is one — keeps a bare host
    origin and is versioned from its path as before.
    """
    owners = rpmdb.owners([row['path'] for row, _, _ in pending if row['path']])
    for row, prefer, explicit in pending:
        record = owners.get(row['path'])
        if record:
            row['origin'] = netstack.origin_rpm(record)
            row['shs'] = netstack.shs_from_release(record['release'])
        else:
            row['origin'] = netstack.origin_host()
        if explicit is not None:
            row['version'], row['version_source'] = explicit
        elif record and record['version']:
            row['version'], row['version_source'] = record['version'], 'rpm'
        else:
            row['version'], row['version_source'] = _version(row['name'],
                                                             row['path'], prefer)


# Header-only build dependencies of the Slingshot fabric libraries. These never
# appear in a runtime dependency tree (there is no .so to load) but they fix the
# NIC / kernel-driver ABI a library was built against — the Spack db is the only
# source.
_SLINGSHOT_HEADER_CONSUMERS = ('libfabric', 'libcxi')
_SLINGSHOT_HEADERS = ('cassini-headers', 'cxi-driver')


def _slingshot_header_rows(db, rows, mount=None):
    """Component rows for the headers the fabric libraries were *built against*.

    cassini-headers and cxi-driver are compiled into libfabric / libcxi
    and govern compatibility with the host CXI kernel driver, but they ship no
    shared object, so `libtree`/`ldd` cannot see them: the edges come from the
    Spack database instead.  One row per distinct (name, dag-hash) — two rows
    for the same header mean the fabric libraries disagree on the NIC ABI.
    """
    if not db:
        return []
    found = {}          # dep hash -> (Package, {consumer names})
    for r in rows:
        if netstack.origin_type(r) != 'uenv' or not r['origin'].get('hash'):
            continue
        if r['name'] not in _SLINGSHOT_HEADER_CONSUMERS:
            continue
        for dep in db.dependencies(r['origin']['hash'], types=('build', 'link')):
            if dep.name in _SLINGSHOT_HEADERS:
                found.setdefault(dep.hash, (dep, set()))[1].add(r['name'])
    out = []
    for dep, consumers in found.values():
        internal = db.is_internal(dep)
        out.append(netstack.component(
            dep.name,
            # A header package built by the uenv is versioned by the SHS release
            # it belongs to, so it has no version of its own to report.  An
            # external record describes a host package, and does.
            version=None if internal else dep.version,
            version_source=None if internal else 'spack',
            shs=netstack.shs_from_spack_version(dep.name, dep.version) if internal else None,
            origin=(netstack.origin_uenv(mount=mount, hash=dep.hash,
                                         spack_version=dep.version)
                    if internal else netstack.origin_host()),
            prefix=os.path.realpath(dep.prefix) if dep.prefix else None,
            # The "Found via" of a build-only dependency is the library it was
            # compiled into.
            via='built into ' + ', '.join(sorted(consumers)),
        ))
    return sorted(out, key=lambda r: (r['name'], r['shs'] or ''))


def _driver_version():
    """CUDA driver version from nvidia-smi, or None."""
    try:
        out = subprocess.run(['nvidia-smi', '--version'], stdout=subprocess.PIPE,
                             stderr=subprocess.DEVNULL)
    except OSError:
        return None
    if out.returncode != 0:
        return None
    m = re.search(r'DRIVER version\s*:\s*([\d.]+)',
                  out.stdout.decode('utf-8', 'replace'), re.IGNORECASE)
    return m.group(1) if m else None


# ---------------------------------------------------------------------------
# environment variables
# ---------------------------------------------------------------------------

# Netstack-relevant environment variables, grouped by the component they tune.
ENVVAR_PATTERNS = [
    (re.compile(r'^MPICH_'),  'cray-mpich'),
    (re.compile(r'^OMPI_'),   'openmpi'),
    (re.compile(r'^FI_'),     'libfabric'),
    (re.compile(r'^OFI_NCCL_'), 'aws-ofi-nccl'),
    (re.compile(r'^NCCL_'),   'nccl'),
    (re.compile(r'^CXI_'),    'libcxi'),
    (re.compile(r'^PMIX_'),   'pmix'),
    (re.compile(r'^PMI_'),    'cray-pmi'),
    (re.compile(r'^PALS_'),   'cray-pals'),
    (re.compile(r'^XPMEM'),   'xpmem'),
    (re.compile(r'^CUDA_'),   'cuda'),
]


def collect_envvars():
    """Return list of {name, value, component} for set netstack env vars."""
    rows = []
    for name, value in sorted(os.environ.items()):
        for pat, comp in ENVVAR_PATTERNS:
            if pat.match(name):
                rows.append({'name': name, 'value': value, 'component': comp})
                break
    return rows


# ---------------------------------------------------------------------------
# rendering
# ---------------------------------------------------------------------------

def print_identity_pretty(ident, providers):
    table = Table(box=box.ROUNDED, show_header=False,
                  border_style=Style(color='grey50'))
    table.add_column('Key', style='bold cyan', no_wrap=True)
    table.add_column('Value', style='bright_white')
    for key, val in (
        ('uenv',   ident.get('label') or ident.get('name')),
        ('view',   ident.get('view')),
        ('mount',  ident.get('mount')),
        ('arch',   ident.get('arch')),
        ('system', ident.get('system')),
    ):
        if val:
            table.add_row(key, str(val))
    if providers:
        table.add_row('fabric providers', ', '.join(providers))
    Console().print(table)


def print_components_pretty(rows):
    netstack.print_components_pretty(rows, COLUMNS)


def print_envvars_pretty(rows):
    if not rows:
        return
    table = Table(box=box.ROUNDED,
                  header_style=Style(color='bright_white', bold=True),
                  border_style=Style(color='grey50'))
    table.add_column('Variable', style='bold cyan', no_wrap=True)
    table.add_column('Value', style='bright_green')
    table.add_column('Affects', style='bright_magenta', no_wrap=True)
    for r in rows:
        table.add_row(r['name'], r['value'], r['component'])
    Console().print(table)


def print_markdown(ident, providers, rows, envvars):
    print('## uenv')
    print()
    id_tbl = [[k, v] for k, v in (
        ('uenv',   ident.get('label') or ident.get('name')),
        ('view',   ident.get('view')),
        ('mount',  ident.get('mount')),
        ('arch',   ident.get('arch')),
        ('system', ident.get('system')),
        ('fabric providers', ', '.join(providers) if providers else None),
    ) if v]
    print(tabulate(id_tbl, headers=['Property', 'Value'], tablefmt='github'))
    print()
    print('## Components')
    print()
    netstack.print_components_markdown(rows, COLUMNS)
    print()
    print('## Environment variables')
    print()
    if envvars:
        env_tbl = [[r['name'], r['value'], r['component']] for r in envvars]
        print(tabulate(env_tbl, headers=['Variable', 'Value', 'Affects'],
                       tablefmt='github'))
    else:
        print('_none of the tracked netstack variables are set_')


def to_json(ident, providers, rows, envvars):
    return {
        'uenv': ident,
        'fabric_providers': providers,
        'components': rows,
        'envvars': envvars,
    }


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        description='Report the user-land network stack of a loaded uenv.')
    parser.add_argument('--format', choices=['pretty', 'markdown', 'json'],
                        default='pretty', help='Output format (default: pretty)')
    args = parser.parse_args()

    ident = _uenv_identity()
    if ident is None:
        if args.format == 'json':
            print(json.dumps({'error': 'no uenv view is loaded'}, indent=2))
        else:
            Console().print(
                '[bold red]No uenv view is loaded.[/bold red]\n'
                'Run inside a uenv, e.g.:\n'
                '  [cyan]uenv run --view=default prgenv-gnu/25.11:v1 -- '
                './bin/user-stack[/cyan]')
        raise SystemExit(1)

    # Load the Spack database (source of truth for identity and build deps).
    # Best-effort: the runtime report still works without it.
    db = None
    if ident.get('mount'):
        candidate = SpackDB(ident['mount'])
        if candidate.exists():
            try:
                candidate._read()
                db = candidate
            except (OSError, ValueError, KeyError):
                db = None

    providers = _fi_providers()
    rows = collect_components(ident, db)
    envvars = collect_envvars()

    if args.format == 'pretty':
        print_identity_pretty(ident, providers)
        print_components_pretty(rows)
        print_envvars_pretty(envvars)
    elif args.format == 'markdown':
        print_markdown(ident, providers, rows, envvars)
    elif args.format == 'json':
        print(json.dumps(to_json(ident, providers, rows, envvars), indent=2))
