#!/usr/bin/env -S uv run --no-refresh --script
# /// script
# requires-python = ">=3.12"
# dependencies = [
#   "rich",
#   "tabulate",
# ]
# ///

# vim: set syntax=python:

"""Report versions of software installed on the system.

Run this on a login or compute node, and not inside a uenv: it reports the
system half of the netstack, which the base OS image provides as RPMs.

Components are reported in the shared record defined in `netstack.py`, the same
one `user-stack` produces for the user half, so the two reports compare field by
field.  Every component here has an RPM origin, or no origin at all when the
package is not installed.

The whole report costs a handful of `rpm` invocations: the components are asked
for in one batch and the GCC toolchains in another, because spawning `rpm` per
package is what makes a tool like this feel slow.
"""

import argparse
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import netstack  # noqa: E402
import rpmdb  # noqa: E402


# Maps logical component name -> list of RPM package names to query (first match wins).
PACKAGES = {
    'cassini-headers': ['cray-cassini-headers-user'],
    'libcxi':          ['cray-libcxi'],
    'cxi-driver':      ['cray-cxi-driver-devel'],
    'libfabric':       ['libfabric'],
    'slurm':           ['slurm'],
    'vast':            ['vastnfs'],
    'lustre':          ['lustre-client'],
    'xpmem':           ['cray-libxpmem-devel', 'xpmem'],
}

# The columns of the component table that this side of the stack can fill.
# There is no runtime resolution here, so no "Found via", and no dag-hash.
COLUMNS = ('name', 'version', 'shs', 'origin', 'prefix')


def collect_components():
    """Query all components and return a list of records.

    A component that is not installed keeps its row, with no origin: that a
    package the system is expected to carry is missing is itself a diagnosis.
    """
    found = rpmdb.query_many([rpm for rpms in PACKAGES.values() for rpm in rpms])
    rows = []
    for name, rpms in PACKAGES.items():
        record = next((found[rpm] for rpm in rpms if rpm in found), None)
        rows.append(netstack.from_rpm(name, record) if record
                    else netstack.component(name))
    return rows


# ---------------------------------------------------------------------------
# Properties
# ---------------------------------------------------------------------------

def _read_os_release():
    """Parse /etc/os-release and return a dict of key->value strings."""
    props = {}
    try:
        with open('/etc/os-release') as f:
            for line in f:
                line = line.strip()
                if '=' not in line:
                    continue
                k, _, v = line.partition('=')
                props[k] = v.strip('"')
    except OSError:
        pass
    return props


def collect_properties():
    """Return a list of {key, value} dicts describing system properties."""
    os_release = _read_os_release()
    name = os_release.get('NAME', '')
    version_id = os_release.get('VERSION_ID', '')
    driver, cuda = netstack.nvidia_versions()

    pairs = [
        ('os', '{} {}'.format(name, version_id) if name and version_id else None),
        ('cluster', os.environ.get('CLUSTER_NAME')),
        ('nvidia-driver', driver),
        ('cuda', cuda),
    ]
    return [{'key': k, 'value': v} for k, v in pairs if v]


# ---------------------------------------------------------------------------
# GCC detection
# ---------------------------------------------------------------------------

_GCC_MAJOR = re.compile(r'gcc(\d+)$')

# The compiler drivers a gccN toolchain can provide: field name, driver
# basename, and the package that has to be installed for it to exist.
_GCC_LANGS = (
    ('c',       'gcc',      'gcc{}'),
    ('cxx',     'g++',      'gcc{}-c++'),
    ('fortran', 'gfortran', 'gcc{}-fortran'),
)


def collect_gcc_data():
    """Discover all installed gccN base packages and return a list of dicts.

    Each dict has keys:
        'major':   int, the GCC major version (e.g. 13)
        'version': str or None
        'prefix':  str or None
        'c', 'cxx', 'fortran': path to the compiler driver, or None

    The set of installed RPM names already answers "is gcc14-fortran there?",
    so it is asked for once and then consulted, rather than re-asking rpm for
    every language of every toolchain.
    """
    installed = rpmdb.names()
    majors = sorted(int(m.group(1)) for name in installed
                    if (m := _GCC_MAJOR.fullmatch(name)))

    bases = rpmdb.query_many(['gcc{}'.format(major) for major in majors])
    rows = []
    for major in majors:
        info = bases.get('gcc{}'.format(major))
        prefix = info['prefix'] if info else None
        version = None
        if info and info['version']:
            # Strip build metadata suffixes like +r278197 or +git9426.
            version = re.sub(r'\+.*$', '', info['version'])

        row = {'major': major, 'version': version, 'prefix': prefix}
        for field, driver, package in _GCC_LANGS:
            row[field] = ('{}/bin/{}-{}'.format(prefix, driver, major)
                          if prefix and package.format(major) in installed
                          else None)
        rows.append(row)
    return rows


# A GCC row is not a component — the three compiler drivers have no counterpart
# in a shared record — but it is still a table, and it is drawn by the same
# renderer so that its pretty, markdown and JSON forms cannot drift apart.
GCC_COLUMNS = [
    netstack.Column('major', 'GCC', style='bold cyan',
                    cell=lambda r: str(r['major'])),
    netstack.Column('version', 'Version', style='bright_green'),
    netstack.Column('c', 'C', style='bright_green', justify='center',
                    absent='✘'),
    netstack.Column('cxx', 'C++', style='bright_green', justify='center',
                    absent='✘'),
    netstack.Column('fortran', 'Fortran', style='bright_green',
                    justify='center', absent='✘'),
    netstack.Column('prefix', 'Prefix', style='bright_magenta'),
]


# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description='Report installed Cray package versions.')
    netstack.add_format_argument(parser)
    args = parser.parse_args()

    prop_rows = collect_properties()
    rows      = collect_components()
    gcc_rows  = collect_gcc_data()

    if args.format == 'json':
        netstack.print_json({
            'properties': prop_rows,
            'components': rows,
            'gcc':        gcc_rows,
        })
    else:
        netstack.print_properties([(r['key'], r['value']) for r in prop_rows],
                                  args.format)
        if args.format == 'markdown':
            print()
        netstack.print_components(rows, COLUMNS, args.format)
        if args.format == 'markdown':
            print()
        netstack.print_table(gcc_rows, GCC_COLUMNS, args.format)
